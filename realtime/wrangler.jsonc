{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dejavu-realtime",
  "main": "party/server.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "Main", "class_name": "Main" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Main"] }]
}
