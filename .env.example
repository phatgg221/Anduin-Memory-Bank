# Copied to .env by `bun run setup`. Never commit .env.
# These are local-development credentials only.

# --- Postgres (pgvector) ---
POSTGRES_USER=memory
POSTGRES_PASSWORD=memory
POSTGRES_DB=memory_bank

# --- MinIO (S3-compatible object storage) ---
MINIO_ACCESS_KEY=memorybank
MINIO_SECRET_KEY=memorybank-dev-secret
MINIO_BUCKET=memory-bank
PRESIGN_TTL_SECONDS=600

# --- LLM & embeddings (gemini | openrouter | fake) ---
# fake = deterministic drafts and hash embeddings (tests/offline). For real summaries via OpenRouter:
#   LLM_PROVIDER=openrouter, LLM_MODEL=<an id from openrouter.ai/models>, OPENROUTER_API_KEY=<your key>
# Embeddings can stay fake, or use EMBEDDING_PROVIDER=openrouter|gemini with a model that outputs EMBEDDING_DIM dims.
# Changing the embedding model or dimension means re-indexing everything (bun run dev --refresh-db).
LLM_PROVIDER=openrouter
LLM_MODEL=
# The triage agent's tool-calling model (OpenRouter id); empty = LLM_MODEL.
AGENT_MODEL=google/gemini-2.5-flash
# Reads scanned PDFs and photos (OCR); empty = AGENT_MODEL.
OCR_MODEL=
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# --- Auth (JWT) ---
# Leave JWT_SECRET empty: `bun run setup` / `bun run dev` generate a random one into .env.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_SECURE=false

# --- Realtime (PartyKit websockets for the war rooms) ---
# Leave empty: `bun run setup` / `bun run dev` generate one. Shared by the API (to publish) and PartyKit (to accept).
REALTIME_SECRET=

# --- Seed ---
# Your registered account's email: `bun run seed` gives it the operator role/department (never a password).
SEED_OPERATOR_EMAIL=
# Dev only, optional: sign in as the active seeded colleagues (e.g. chloe.nguyen@anduin.tech) with this password
# to test the war rooms from several accounts. Empty = they can't sign in. Applied by `bun run seed`.
SEED_DEMO_PASSWORD=

# --- Host ports (change any that clash with services already running on your machine) ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5433
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
PGWEB_PORT=8081
REALTIME_PORT=1999
