# Copied to .env by `bun run setup`. Never commit .env.
# These are local-development credentials only.

# --- Postgres (pgvector) ---
POSTGRES_USER=memory
POSTGRES_PASSWORD=memory
POSTGRES_DB=memory_bank

# --- MinIO (S3-compatible object storage) ---
MINIO_ACCESS_KEY=memorybank
MINIO_SECRET_KEY=memorybank-dev-secret
MINIO_BUCKET=memory-bank
PRESIGN_TTL_SECONDS=600

# --- LLM & embeddings (gemini | openrouter | fake) ---
LLM_PROVIDER=fake
LLM_MODEL=
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Host ports (change any that clash with services already running on your machine) ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5433
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
PGWEB_PORT=8081
