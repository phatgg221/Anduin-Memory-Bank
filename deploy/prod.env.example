# Production config for `bun run deploy …` (docs/DEPLOY.md). `bun run deploy init` copies this to
# deploy/prod.env (gitignored) and generates the secrets. KEY=value, no quotes.

# --- Google Cloud (backend on Cloud Run) ---
GCP_PROJECT=
GCP_REGION=us-east1

# --- Cloudflare Workers (realtime): the Account ID `bunx wrangler whoami` shows (may differ from R2's). `bun run deploy realtime` fills REALTIME_HOST ---
CLOUDFLARE_ACCOUNT_ID=
REALTIME_HOST=

# --- Neon Postgres (pgvector): the direct (non-pooled) connection string, as Neon shows it ---
DATABASE_URL=

# --- Cloudflare R2 (S3 API): endpoint without https://, an R2 API token's access key + secret ---
MINIO_ENDPOINT=<account-id>.r2.cloudflarestorage.com
MINIO_PUBLIC_ENDPOINT=<account-id>.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=dejavu
MINIO_SECURE=true
MINIO_PUBLIC_SECURE=true
PRESIGN_TTL_SECONDS=600

# --- LLM & embeddings: same as your dev .env ---
LLM_PROVIDER=openrouter
LLM_MODEL=
AGENT_MODEL=google/gemini-2.5-flash
OCR_MODEL=
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Auth & realtime: generated by `bun run deploy init`; shared by Cloud Run, the realtime Worker and Vercel ---
JWT_SECRET=
REALTIME_SECRET=
REFRESH_COOKIE_SECURE=true

# --- Seed (`bun run deploy seed`) ---
SEED_OPERATOR_EMAIL=
SEED_DEMO_PASSWORD=
